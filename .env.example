# =====================================================================
# Splitwise AI — Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment
# =====================================================================

# Database Configuration (MySQL 8.0+)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/expense_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Backend Server Configuration
SERVER_PORT=8080
JWT_SECRET=generate-a-strong-random-256-bit-hex-string-for-production-signing
JWT_EXPIRATION_MS=3600000

# Inter-Service Security
INTERNAL_API_SECRET=splitwise-ai-internal-secret-2026
AI_SERVICE_URL=http://localhost:8000
RECEIPTS_DIR=uploads/receipts

# AI Microservice Configuration (Python FastAPI)
AI_SERVICE_PORT=8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
INFERENCE_TIMEOUT=90

# Optional Tesseract OCR Executable Path (if not on system PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
